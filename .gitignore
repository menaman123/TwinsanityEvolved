# --- build output (reproducible; prune when disk < 15 GB) ---
/build/
/build-*/
/dist/
/out/
/cmake-build-*/
compile_commands.json
*.o
*.a
*.wasm
*.wat
*.ll

# --- pinned toolchain, fetched by tools/fetch_toolchain.sh (never committed) ---
/tools/toolchain/*
!/tools/toolchain/README.md
!/tools/toolchain/PINS.sha256

# --- GAME DATA OF ANY KIND: never in this tree (tools/ci/asset_scan.py) ---
*.iso
*.ISO
*.bin
*.BIN
*.cue
*.img
*.IMG
*.elf
*.ELF
*.irx
*.IRX
*.ps2st
*.p2s
*.mcd
*.ps2
*.psu
# the title executables: the digit/dot shape spelled out -- git matches case-insensitively on macOS, so `SLUS_*` would
# swallow the engine's games/slus_<serial>_<slug>/ tree
SLUS_???.??
SLES_???.??
SCUS_???.??
SCES_???.??
SLUS_???.??;1
SLES_???.??;1
SYSTEM.CNF
IOPRP???.IMG
*.PSS
*.pss
*.VAG
*.vag
*.BD
*.BH
*.MB
*.MH
*.RM2
*.SM2
*.PSF
*.psf
*.TGA
*.tga
*.DDS
*.dds
*.PNG
*.png
# the one picture exemption (tools/ci/asset_scan.sh): the launcher's own window for README, nothing of the disc
!/docs/launcher/screenshots/launcher-*.png
*.jpg
*.jpeg
*.wav
*.mp3
*.ogg
*.mp4
*.avi
*.mov
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz
*.gz
*.xz
*.zst
/asm/
/assets/
/ghidra/
memcards/
memcards_fresh/

# --- editor / OS ---
.cache/
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db
__pycache__/
*.py[cod]
.venv/

# --- manual play dirs and build logs in the checkout (never committed) ---
my_play*/
build*.log
